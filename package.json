{
	"name": "webext-tools",
	"version": "4.1.2",
	"description": "Utility functions for Web Extensions",
	"license": "MIT",
	"repository": "fregante/webext-tools",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"./*": "./distribution/*"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"demo:build": "parcel build --no-cache",
		"demo:watch": "parcel watch --no-cache --no-hmr",
		"prepack": "tsc --sourceMap false",
		"test": "xo && npm run test:unit && npm run demo:build",
		"test:unit": "node --import ./setup-tests.js --test source/*.test.ts",
		"watch": "tsc --watch"
	},
	"files": [
		"distribution"
	],
	"keywords": [
		"extension",
		"chrome",
		"firefox",
		"safari",
		"web",
		"extensions",
		"execute",
		"function",
		"browser"
	],
	"dependencies": {
		"webext-detect": "^6.0.0",
		"webext-patterns": "^3.0.0"
	},
	"devDependencies": {
		"@parcel/config-webextension": "^2.16.4",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.5",
		"@types/node": "^26.6.5",
		"@types/sinon-chrome": "^2.2.16",
		"parcel": "^2.16.4",
		"sinon-chrome": "^3.0.1",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"targets": {
		"main": false,
		"default": {
			"engines": {
				"browsers": "last 1 chrome version"
			},
			"source": "./source/demo/manifest.json",
			"distDir": "./.built/demo",
			"sourceMap": {
				"inline": true
			},
			"optimize": false
		}
	},
	"webExt": {
		"sourceDir": ".built/demo",
		"run": {
			"startUrl": [
				"https://example.com"
			]
		}
	}
}
